{
  "manifest_version": 3,
  "name": "Birmarket & Temu Product CSV Exporter",
  "version": "1.1.0",
  "description": "Save products you open on Birmarket or Temu and export names, specifications and photo URLs to CSV.",
  "permissions": ["scripting", "storage", "downloads"],
  "host_permissions": ["https://birmarket.az/*", "https://www.birmarket.az/*", "https://temu.com/*", "https://www.temu.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Birmarket & Temu Product CSV Exporter" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
