generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  role          String     @default("PARTNER")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  partner       Partner?
  admin         AdminUser?
}

model AdminUser {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model PartnerAuth {
  id        String   @id @default(cuid())
  partnerId String   @unique
  partner   Partner  @relation(fields: [partnerId], references: [id])
  createdAt DateTime @default(now())
}

model ProductCategory {
  id       String            @id @default(cuid())
  name     String
  slug     String            @unique
  parentId String?
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]
  featured Boolean           @default(false)
}

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String
  shortDescription String          @default("")
  needsPriceReview Boolean         @default(false)
  rightsReviewRequired Boolean     @default(false)
  rightsClearance String           @default("")
  categoryId     String
  category       ProductCategory  @relation(fields: [categoryId], references: [id])
  status         String           @default("DRAFT")
  featured       Boolean          @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  variants       ProductVariant[]
  images         ProductImage[]
  slugAliases    ProductSlugAlias[]

  @@index([status, categoryId])
}

model ProductSlugAlias {
  oldSlug   String   @id
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id              String              @id @default(cuid())
  productId       String
  product         Product             @relation(fields: [productId], references: [id])
  name            String              @default("Standart")
  sku             String              @unique
  storeSku        String?             @unique
  costMinor       Int
  priceMinor      Int
  discountMinor   Int?
  commissionMinor Int?
  stock           Int                 @default(0)
  stockVerified   Boolean             @default(false)
  reserved        Int                 @default(0)
  lowStock        Int                 @default(5)
  active          Boolean             @default(true)
  movements       InventoryMovement[]
  orderItems      OrderItem[]
}

model StoreSkuCounter {
  id    String @id
  value Int    @default(0)
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  key       String  @unique
  alt       String
  position  Int     @default(0)
  sourceUrlHash String?

  @@unique([productId, sourceUrlHash])
}

model InventoryMovement {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  orderId   String?
  order     Order?         @relation(fields: [orderId], references: [id])
  kind      String
  quantity  Int
  reason    String
  createdAt DateTime       @default(now())

  @@index([variantId, createdAt])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  notes     String   @default("")
  orders    Order[]
  createdAt DateTime @default(now())
}

model Order {
  id                   String               @id @default(cuid())
  reference            String               @unique
  idempotencyKey       String               @unique
  requestHash          String
  customerId           String
  customer             Customer             @relation(fields: [customerId], references: [id])
  customerName         String
  phone                String
  city                 String
  address              String
  notes                String               @default("")
  status               String               @default("WHATSAPP_PENDING")
  paymentStatus        String               @default("UNPAID")
  deliveryStatus       String               @default("PENDING")
  subtotalMinor        Int
  deliveryChargedMinor Int                  @default(0)
  totalMinor           Int
  paidMinor            Int                  @default(0)
  refundedMinor        Int                  @default(0)
  deliveryCostMinor    Int                  @default(0)
  packagingCostMinor   Int                  @default(0)
  inventoryState       String               @default("RESERVED")
  reservationExpiresAt DateTime
  commissionRuleId     String
  commissionRule       CommissionRule       @relation(fields: [commissionRuleId], references: [id])
  commissionMinor      Int
  minimumOrderMinor    Int
  holdDays             Int
  partnerId            String?
  partner              Partner?             @relation(fields: [partnerId], references: [id])
  referralCode         String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  completedAt          DateTime?
  items                OrderItem[]
  history              OrderStatusHistory[]
  payments             Payment[]
  movements            InventoryMovement[]
  attribution          ReferralAttribution?
  commission           Commission?
  syncJob              IntegrationSyncJob?

  @@index([status, createdAt])
  @@index([partnerId, createdAt])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id])
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  productName    String
  variantName    String
  sku            String
  categoryName   String
  quantity       Int
  unitPriceMinor Int
  unitCostMinor  Int
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  status    String
  note      String
  actorId   String?
  createdAt DateTime @default(now())
}

model Payment {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id])
  idempotencyKey String   @unique
  kind           String
  amountMinor    Int
  method         String
  reference      String
  createdAt      DateTime @default(now())
}

model Partner {
  id              String                 @id @default(cuid())
  userId          String                 @unique
  user            User                   @relation(fields: [userId], references: [id])
  auth            PartnerAuth?
  name            String
  phone           String
  email           String?
  category        String
  businessName    String                 @default("")
  code            String                 @unique
  status          String                 @default("ACTIVE")
  commissionMinor Int?
  payoutInfo      String                 @default("")
  notes           String                 @default("")
  createdAt       DateTime               @default(now())
  orders          Order[]
  visits          ReferralVisit[]
  attributions    ReferralAttribution[]
  commissions     Commission[]
  adjustments     CommissionAdjustment[]
  payouts         Payout[]
  disputes        ReferralDispute[]
}

model ReferralVisit {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id])
  createdAt DateTime @default(now())

  @@index([partnerId, createdAt])
}

model ReferralAttribution {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id])
  code      String
  source    String
  createdAt DateTime @default(now())
}

model CommissionRule {
  id                String       @id @default(cuid())
  amountMinor       Int
  minimumOrderMinor Int          @default(0)
  holdDays          Int          @default(7)
  approvalPolicy    String       @default("MANUAL")
  payoutFrequency   String       @default("MONTHLY")
  createdAt         DateTime     @default(now())
  orders            Order[]
  commissions       Commission[]
}

model Commission {
  id          String                 @id @default(cuid())
  orderId     String                 @unique
  order       Order                  @relation(fields: [orderId], references: [id])
  partnerId   String
  partner     Partner                @relation(fields: [partnerId], references: [id])
  ruleId      String
  rule        CommissionRule         @relation(fields: [ruleId], references: [id])
  amountMinor Int
  status      String                 @default("PENDING")
  eligibleAt  DateTime
  createdAt   DateTime               @default(now())
  approvedAt  DateTime?
  paidAt      DateTime?
  adjustments CommissionAdjustment[]
  allocation  PayoutAllocation?

  @@index([partnerId, status])
}

model CommissionAdjustment {
  id           String     @id @default(cuid())
  commissionId String     @unique
  commission   Commission @relation(fields: [commissionId], references: [id])
  partnerId    String
  partner      Partner    @relation(fields: [partnerId], references: [id])
  amountMinor  Int
  reason       String
  createdAt    DateTime   @default(now())
  payoutId     String?
  payout       Payout?    @relation(fields: [payoutId], references: [id])
}

model Payout {
  id             String                 @id @default(cuid())
  partnerId      String
  partner        Partner                @relation(fields: [partnerId], references: [id])
  idempotencyKey String                 @unique
  amountMinor    Int
  method         String
  reference      String
  createdAt      DateTime               @default(now())
  allocations    PayoutAllocation[]
  adjustments    CommissionAdjustment[]
}

model PayoutAllocation {
  id           String     @id @default(cuid())
  payoutId     String
  payout       Payout     @relation(fields: [payoutId], references: [id])
  commissionId String     @unique
  commission   Commission @relation(fields: [commissionId], references: [id])
  amountMinor  Int
}

model ReferralDispute {
  id          String    @id @default(cuid())
  partnerId   String
  partner     Partner   @relation(fields: [partnerId], references: [id])
  orderRef    String?
  orderDate   DateTime
  explanation String
  support     String    @default("")
  status      String    @default("OPEN")
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  amountMinor Int
  date        DateTime
  description String
  attachment  String?
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  audience  String
  userId    String?
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([audience, userId, createdAt])
}

model StoreSettings {
  id                String   @id @default("store")
  brandName         String
  legalName         String   @default("")
  taxId             String   @default("")
  businessAddress   String   @default("")
  domain            String
  description       String
  logoKey           String?
  faviconKey        String?
  primaryColor      String   @default("#c4f563")
  backgroundColor   String   @default("#101b18")
  whatsapp          String   @default("")
  phone             String   @default("")
  email             String   @default("")
  instagram         String   @default("")
  tiktok            String   @default("")
  socialLinks       String   @default("")
  announcement      String   @default("")
  heroTitle         String
  heroSubtitle      String
  heroImageKey      String?
  deliveryInfo      String
  deliveryRegions   String   @default("Bakı, Abşeron, Digər bölgələr")
  deliveryTime      String   @default("")
  deliveryFreeRegions String @default("")
  deliveryFeeMinor  Int      @default(0)
  freeDeliveryMinor Int      @default(0)
  attributionDays   Int      @default(30)
  showFeatured      Boolean  @default(true)
  showNewArrivals   Boolean  @default(true)
  showCategories    Boolean  @default(true)
  sheetsEnabled     Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  detail    Json
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
}

model IntegrationSyncJob {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  status    String   @default("PENDING")
  version   Int      @default(1)
  sheetRow  Int?     @unique
  attempts  Int      @default(0)
  nextRunAt DateTime @default(now())
  lastError String?
  updatedAt DateTime @updatedAt
}

model IntegrationState {
  id          String   @id
  lockedUntil DateTime
  nextRow     Int      @default(2)
}

model RateLimit {
  id        String   @id
  count     Int      @default(1)
  expiresAt DateTime
}
