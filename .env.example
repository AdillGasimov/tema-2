DATABASE_URL=postgresql://store:CHANGE_ME@127.0.0.1:5432/store
# Per-worker pool size; keep small for serverless database connection limits.
DATABASE_POOL_MAX=1
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
REFERRAL_SECRET=
JOB_SECRET=
# Optional Vercel private Blob storage; connecting a store supplies this token.
# S3_BUCKET takes precedence when using the existing S3 backend.
BLOB_READ_WRITE_TOKEN=
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=store-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Local compose credentials only; do not reuse in production.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Private account creation / one-time first-admin release setup.
# Remove both after first-admin setup; never set NEXT_PUBLIC_ credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional Google Sheets reporting; JSON is server-only, never committed.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
